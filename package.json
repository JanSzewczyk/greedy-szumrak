{
  "name": "greedy-szumrak",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "ANALYZE=true npm run build",
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint",
    "lint:ci": "eslint . -o eslint-results.sarif -f @microsoft/eslint-formatter-sarif",
    "lint:fix": "eslint --fix",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "start": "next start",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:serve": "serve storybook-static",
    "test": "vitest run --passWithNoTests",
    "test:ci": "CI=true vitest --passWithNoTests",
    "test:coverage": "vitest --coverage --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:ci": "CI=true playwright test --pass-with-no-tests",
    "test:e2e:ui": "playwright test --ui --pass-with-no-tests",
    "test:storybook": "vitest --project=storybook --coverage --passWithNoTests",
    "test:ui": "vitest --ui",
    "test:unit": "vitest --project=unit --coverage --passWithNoTests",
    "test:watch": "vitest watch --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.36.8",
    "@clerk/themes": "^2.4.48",
    "@hookform/resolvers": "^5.2.2",
    "@next/bundle-analyzer": "^16.1.3",
    "@szum-tech/design-system": "^3.9.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tailwindcss/postcss": "^4.1.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "firebase-admin": "^13.5.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.562.0",
    "next": "^16.1.3",
    "next-compose-plugins": "^2.2.1",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.71.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@faker-js/faker": "^10.2.0",
    "@jackfranklin/test-data-bot": "^2.1.0",
    "@playwright/test": "^1.57.0",
    "@storybook-community/storybook-dark-mode": "^7.1.0",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/nextjs-vite": "^10.1.11",
    "@szum-tech/eslint-config": "^2.1.15",
    "@szum-tech/prettier-config": "^1.6.5",
    "@szum-tech/semantic-release-config": "^2.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.2",
    "prettier": "^3.8.0",
    "semantic-release": "^25.0.2",
    "serve": "^14.2.5",
    "storybook": "^10.1.10",
    "storybook-addon-tag-badges": "^3.0.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.16"
  }
}
